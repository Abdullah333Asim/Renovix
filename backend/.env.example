# ── Server & CORS ──
CORS_ORIGINS_STR=http://localhost:5173
STORAGE_DIR=./data
PIPELINE_MODE=real

# ── Multimodal Vision LLM Spatial Planner (Optional but Recommended) ──
# Set either GEMINI_API_KEY (Google AI Studio) or OPENAI_API_KEY (OpenAI Platform).
# If left blank, the system automatically uses geometric 2D bounding box projections.
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── Hugging Face & Model Weights (Optional) ──
HUGGINGFACE_TOKEN=
SAM2_CHECKPOINT=./weights/sam2_hiera_large.pt
GROUNDING_DINO_CONFIG=./weights/GroundingDINO_SwinT_OGC.cfg.py
GROUNDING_DINO_CHECKPOINT=./weights/groundingdino_swint_ogc.pth
LAMA_MODEL_DIR=./weights/big-lama
TRIPOSR_MODEL_ID=stabilityai/TripoSR
